{
  "name": "@ohos-rs/oxk",
  "version": "0.4.1",
  "description": "An ArkTS/ArkUI tool based on oxc",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.js",
  "bin": {
    "oxk": "./bin/oxk.js"
  },
  "repository": {
    "url": "git+https://github.com/ohos-rs/oxc-ark.git",
    "type": "git"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api",
    "ArkTS",
    "ArkUI",
    "formatter",
    "oxc"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js",
    "format.js",
    "format.d.ts",
    "lint.js",
    "lint.d.ts",
    "oxlint-runtime",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./format": {
      "types": "./format.d.ts",
      "default": "./format.js"
    },
    "./lint": {
      "types": "./lint.d.ts",
      "default": "./lint.js"
    }
  },
  "napi": {
    "binaryName": "oxk",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release --no-dts-cache",
    "build:debug": "napi build --platform --no-dts-cache",
    "build:debug:binding": "node scripts/build-binding-only.cjs",
    "build:oxlint-runtime": "node scripts/build-oxlint-runtime.mjs",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "test:binding": "ava __test__/index.spec.ts __test__/format.spec.ts",
    "test:cli": "ava __test__/cli.spec.ts",
    "test:wasi": "node scripts/smoke-wasi.cjs",
    "test:build": "pnpm run build:debug && pnpm run test",
    "version": "napi version"
  },
  "dependencies": {
    "glob": "^11.1.0",
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@napi-rs/wasm-runtime": "^1.0.4",
    "@oxc-node/core": "^0.0.35",
    "@tybys/wasm-util": "^0.10.0",
    "@typescript-eslint/scope-manager": "^8.59.3",
    "ajv": "6.14.0",
    "ava": "^6.4.1",
    "chalk": "^5.6.2",
    "emnapi": "^1.5.0",
    "esbuild": "0.25.11",
    "eslint": "^9.39.4",
    "esquery": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "tinybench": "^6.0.0",
    "typescript": "^5.9.2"
  },
  "ava": {
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  }
}
